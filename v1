local oldV3Index
oldV3Index = hookmetamethod(v3, "__index", newcclosure(function(self, key)
	if not checkcaller() and tostring(key) == "Magnitude" then
		local script = getcallingscript()
		if script then
			local name = tostring(script):lower()
			if name:find("anti") or name:find("cheat") or name:find("check") or name:find("dist") then
				return 0 
			end
		end
	end
	return oldV3Index(self, key)
end))


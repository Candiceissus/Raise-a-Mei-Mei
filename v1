-- Cleanup function.
local function destroy()
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	connections = {}
	enabled.autoClick = false
	enabled.autoAcorn = false
	enabled.autoCrystal = false
	enabled.autoUnpackage = false
	isCollectingCrystal = false
	cachedPetClick = nil

	local old = game:GetService("CoreGui"):FindFirstChild("RaiseMeiMei")
	if old then old:Destroy() end

	shared.RaiseMeiMei = nil 
end

shared.RaiseMeiMei = { destroy = destroy }


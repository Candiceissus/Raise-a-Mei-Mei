-- Find the ClickDetector for the BIG MeiMei, fallback to PetClick
local function findPetClick()
	if cachedPetClick and cachedPetClick.Parent then
		return cachedPetClick
	end
	
	cachedPetClick = nil
	
	-- 1. Use the exact path you provided
	local meiMeiStuff = workspace:FindFirstChild("MeiMeiStuff")
	if meiMeiStuff then
		local meiMei = meiMeiStuff:FindFirstChild("MeiMei")
		if meiMei then
			local body = meiMei:FindFirstChild("Body")
			if body then
				local cd = body:FindFirstChild("PetClick")
				if cd and cd:IsA("ClickDetector") then
					cachedPetClick = cd
					return cd
				end
			end
		end
	end

	-- 2. Fallback: Search everything for PetClick (if something changes)
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj.Name == "PetClick" and obj:IsA("ClickDetector") then
			cachedPetClick = obj
			return obj
		end
	end
end

-- Auto Click logic. (Throttled to 20 clicks/sec)
local autoClickConn = nil
local function startAutoClick()
	local c = runService.Heartbeat:Connect(function()
		if os.clock() - lastClickTime < 0.05 then return end
		lastClickTime = os.clock()
		
		local detector = findPetClick()
		if not detector then return end
		detector.MaxActivationDistance = 9999
		fireclickdetector(detector)
	end)
	table.insert(connections, c)
	return c
end

-- Auto Find Acorn logic. (Throttled to 10 touches/sec)
local autoAcornConn = nil
local function startAutoAcorn()
	local c = runService.Heartbeat:Connect(function()
		if os.clock() - lastAcornTime < 0.1 then return end
		lastAcornTime = os.clock()
		
		local acornHunt = workspace:FindFirstChild("AcornHunt")
		if not acornHunt then return end

		local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local acorn = acornHunt:FindFirstChild("Acorn")
		if acorn then
			local hit = acorn:FindFirstChild("Hit")
			if hit then firetouchinterest(hit, hrp, 0) end
		end

		local goldenAcorn = acornHunt:FindFirstChild("GoldenAcorn")
		if goldenAcorn then
			local hit = goldenAcorn:FindFirstChild("Hit")
			if hit then firetouchinterest(hit, hrp, 0) end
		end
	end)
	table.insert(connections, c)
	return c
end

-- Auto Collect Crystal logic. (Throttled to search 5 times/sec)
local autoCrystalConn = nil

local function startAutoCrystal()
	local c = runService.Heartbeat:Connect(function()
		if isCollectingCrystal then return end
		if os.clock() - lastCrystalSearch < 0.2 then return end 
		lastCrystalSearch = os.clock()

		local palace = workspace:FindFirstChild("MeiMeiPalaceLocal")
		if not palace then return end

		local character = localPlayer.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local targetBasePart = nil

		-- Check Portraits
		local portraitsFolder = palace:FindFirstChild("Portraits")
		if portraitsFolder then
			for _, portrait in ipairs(portraitsFolder:GetChildren()) do
				if portrait.Name == "Portrait" then
					local canvas = portrait:FindFirstChild("Canvas")
					if canvas and canvas:IsA("BasePart") and canvas.Transparency < 0.9 then
						targetBasePart = canvas
						break
					end
				end
			end
		end

		-- Check Meteors
		if not targetBasePart then
			local meteorsFolder = palace:FindFirstChild("Meteors")
			if meteorsFolder then
				for _, meteor in ipairs(meteorsFolder:GetChildren()) do
					if meteor.Name == "Meteor" then
						local mainPart = meteor:FindFirstChildWhichIsA("BasePart")
						if mainPart and mainPart.Transparency < 0.9 then
							targetBasePart = mainPart
							break
						end
					end
				end
			end
		end

		-- Check Crystals
		if not targetBasePart then
			local crystalsFolder = palace:FindFirstChild("Crystals")
			if crystalsFolder then
				for _, child in ipairs(crystalsFolder:GetChildren()) do
					if child.Name == "Crystal" then
						local basePart = child:FindFirstChild("Base")
						if basePart and basePart:IsA("BasePart") and basePart.Transparency < 0.9 then
							targetBasePart = basePart
							break
						end
					end
				end
			end
		end

		if not targetBasePart then return end

		isCollectingCrystal = true
		task.spawn(function()
			local originalCFrame = hrp.CFrame
			local targetCFrame = CFrame.new(targetBasePart.Position + Vector3.new(0, 3, 0))
			
			local distance = (originalCFrame.Position - targetCFrame.Position).Magnitude
			local speed = 350 
			local duration = distance / speed
			
			local tween = tweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
			tween:Play()
			tween.Completed:Wait()
			
			hrp.AssemblyLinearVelocity = Vector3.zero
			task.wait(0.5) 
			
			local tweenBack = tweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = originalCFrame})
			tweenBack:Play()
			tweenBack.Completed:Wait()
			
			task.wait(0.1)
			isCollectingCrystal = false
		end)
	end)
	table.insert(connections, c)
	return c
end

-- TP to each balloon, fire it, then return.
local function popAllBalloons(btn)
	btn.Text = "Popping..."
	btn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
	btn.Active = false

	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		btn.Text = "Pop Balloons"
		btn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
		btn.Active = true
		return
	end

	local originalCFrame = hrp.CFrame

	local grandOpening = workspace:FindFirstChild("GrandOpening")
	if grandOpening then
		for i = 1, 8 do
			local balloon = grandOpening:FindFirstChild("Balloon" .. i)
			if balloon then
				local cd = nil
				for _, obj in ipairs(balloon:GetDescendants()) do
					if obj:IsA("ClickDetector") then
						cd = obj
						break
					end
				end

				if cd then
					hrp.CFrame = CFrame.new(cd.Parent.Position)
					task.wait(0.5)
					fireclickdetector(cd)
					task.wait(1)
				end
			end
		end
	end

	hrp.CFrame = originalCFrame

	task.wait(0.5)
	btn.Text = "Pop Balloons"
	btn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
	btn.Active = true
end


-- Auto Collect Crystal logic. (Nearest Target)
local autoCrystalConn = nil

local function startAutoCrystal()
	local c = runService.Heartbeat:Connect(function()
		if isCollectingCrystal then return end
		if os.clock() - lastCrystalSearch < 0.2 then return end 
		lastCrystalSearch = os.clock()

		local palace = workspace:FindFirstChild("MeiMeiPalaceLocal")
		if not palace then return end

		local character = localPlayer.Character
		local hrp = character and character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local targetBasePart = nil
		local closestDistance = math.huge

		local function checkTarget(part)
			if part and part:IsA("BasePart") and part.Transparency < 0.9 then
				local dist = (hrp.Position - part.Position).Magnitude
				if dist < closestDistance then
					closestDistance = dist
					targetBasePart = part
				end
			end
		end

		-- Check Portraits
		local portraitsFolder = palace:FindFirstChild("Portraits")
		if portraitsFolder then
			for _, portrait in ipairs(portraitsFolder:GetChildren()) do
				if portrait.Name == "Portrait" then
					checkTarget(portrait:FindFirstChild("Canvas"))
				end
			end
		end

		-- Check Meteors
		local meteorsFolder = palace:FindFirstChild("Meteors")
		if meteorsFolder then
			for _, meteor in ipairs(meteorsFolder:GetChildren()) do
				if meteor.Name == "Meteor" then
					checkTarget(meteor:FindFirstChildWhichIsA("BasePart"))
				end
			end
		end

		-- Check Crystals
		local crystalsFolder = palace:FindFirstChild("Crystals")
		if crystalsFolder then
			for _, child in ipairs(crystalsFolder:GetChildren()) do
				if child.Name == "Crystal" then
					checkTarget(child:FindFirstChild("Base"))
				end
			end
		end

		if not targetBasePart then return end

		isCollectingCrystal = true
		task.spawn(function()
			local originalCFrame = hrp.CFrame
			local targetCFrame = CFrame.new(targetBasePart.Position + Vector3.new(0, 3, 0))
			
			local distance = (originalCFrame.Position - targetCFrame.Position).Magnitude
			local speed = 48 
			local duration = distance / speed
			
			local tween = tweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
			tween:Play()
			tween.Completed:Wait()
			
			hrp.AssemblyLinearVelocity = Vector3.zero
			task.wait(0.5) 
			
			local tweenBack = tweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = originalCFrame})
			tweenBack:Play()
			tweenBack.Completed:Wait()
			
			task.wait(0.1)
			isCollectingCrystal = false
		end)
	end)
	table.insert(connections, c)
	return c
end

-- TP to each balloon, fire it, then return.
local function popAllBalloons(btn)
	btn.Text = "Popping..."
	btn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
	btn.Active = false

	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		btn.Text = "Pop Balloons"
		btn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
		btn.Active = true
		return
	end

	local originalCFrame = hrp.CFrame

	local grandOpening = workspace:FindFirstChild("GrandOpening")
	if grandOpening then
		for i = 1, 8 do
			local balloon = grandOpening:FindFirstChild("Balloon" .. i)
			if balloon then
				local cd = nil
				for _, obj in ipairs(balloon:GetDescendants()) do
					if obj:IsA("ClickDetector") then
						cd = obj
						break
					end
				end

				if cd then
					hrp.CFrame = CFrame.new(cd.Parent.Position)
					task.wait(0.5)
					fireclickdetector(cd)
					task.wait(1)
				end
			end
		end
	end

	hrp.CFrame = originalCFrame

	task.wait(0.5)
	btn.Text = "Pop Balloons"
	btn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
	btn.Active = true
end


-- Helper to create toggle buttons.
local function makeToggle(text, yPos)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 180, 0, 28)
	btn.Position = UDim2.new(0.5, -90, 0, yPos)
	btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 13
	btn.Font = Enum.Font.Gotham
	btn.BorderSizePixel = 0
	btn.Parent = frame
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 6)
	c.Parent = btn
	return btn
end

local autoClickBtn = makeToggle("Auto Click", 28)
local autoCornBtn = makeToggle("Auto Find Corn", 62)

-- Auto Click toggle.
autoClickBtn.MouseButton1Click:Connect(function()
	enabled.autoClick = not enabled.autoClick
	if enabled.autoClick then
		autoClickBtn.Text = "Auto Click: ON"
		autoClickBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
		autoClickConn = startAutoClick()
	else
		autoClickBtn.Text = "Auto Click"
		autoClickBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		if autoClickConn then
			autoClickConn:Disconnect()
			autoClickConn = nil
		end
	end
end)

-- Auto Find Corn toggle.
autoCornBtn.MouseButton1Click:Connect(function()
	enabled.autoCorn = not enabled.autoCorn
	if enabled.autoCorn then
		autoCornBtn.Text = "Auto Find Corn: ON"
		autoCornBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
		autoCornConn = startAutoCorn()
	else
		autoCornBtn.Text = "Auto Find Corn"
		autoCornBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		if autoCornConn then
			autoCornConn:Disconnect()
			autoCornConn = nil
		end
	end
end)

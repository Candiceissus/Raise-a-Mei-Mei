-- Check for table that is shared between executions.
if not shared then
	return warn("No shared, no script.")
end

-- Destroy previous instance if it exists.
if shared.RaiseMeiMei then
	shared.RaiseMeiMei.destroy()
end

-- Services.
local playersService = game:GetService("Players")
local runService = game:GetService("RunService")

local localPlayer = playersService.LocalPlayer

-- State.
local connections = {}
local enabled = { autoClick = false, autoAcorn = false, autoCrystal = false }
local isCollectingCrystal = false

-- Cleanup function.
local function destroy()
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	connections = {}
	enabled.autoClick = false
	enabled.autoAcorn = false
	enabled.autoCrystal = false
	isCollectingCrystal = false

	local old = game:GetService("CoreGui"):FindFirstChild("RaiseMeiMei")
	if old then old:Destroy() end
end

shared.RaiseMeiMei = { destroy = destroy }

-- Find PetClick under workspace.
local function findPetClick()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj.Name == "PetClick" and obj:IsA("ClickDetector") then
			return obj
		end
	end
end

-- Auto Click logic.
local autoClickConn = nil

local function startAutoClick()
	local c = runService.Heartbeat:Connect(function()
		local detector = findPetClick()
		if not detector then return end
		detector.MaxActivationDistance = 9999
		fireclickdetector(detector)
	end)
	table.insert(connections, c)
	return c
end

-- Auto Find Acorn logic.
local autoAcornConn = nil

local function startAutoAcorn()
	local c = runService.Heartbeat:Connect(function()
		local acornHunt = workspace:FindFirstChild("AcornHunt")
		if not acornHunt then return end

		local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local acorn = acornHunt:FindFirstChild("Acorn")
		if acorn then
			local hit = acorn:FindFirstChild("Hit")
			if hit then firetouchinterest(hit, hrp, 0) end
		end

		local goldenAcorn = acornHunt:FindFirstChild("GoldenAcorn")
		if goldenAcorn then
			local hit = goldenAcorn:FindFirstChild("Hit")
			if hit then firetouchinterest(hit, hrp, 0) end
		end
	end)
	table.insert(connections, c)
	return c
end

-- Auto Collect Crystal logic.
local autoCrystalConn = nil

local function startAutoCrystal()
	local c = runService.Heartbeat:Connect(function()
		if isCollectingCrystal then return end

		local palace = workspace:FindFirstChild("MeiMeiPalaceLocal")
		if not palace then return end
		local crystalsFolder = palace:FindFirstChild("Crystals")
		if not crystalsFolder then return end

		local hrp = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local targetBasePart = nil
		
		for _, child in ipairs(crystalsFolder:GetChildren()) do
			if child.Name == "Crystal" then
				local basePart = child:FindFirstChild("Base")
				if basePart and basePart:IsA("BasePart") and basePart.Transparency < 0.9 then
					targetBasePart = basePart
					break
				end
			end
		end

		if not targetBasePart then return end

		isCollectingCrystal = true
		task.spawn(function()
			local originalCFrame = hrp.CFrame
			
			-- Teleport to the crystal.
			hrp.CFrame = CFrame.new(targetBasePart.Position + Vector3.new(0, 3, 0))
			task.wait(0.2)
			
			-- Trigger the touch.
			firetouchinterest(targetBasePart, hrp, 0)
			task.wait(0.5)
			
			-- Return to original spot.
			if hrp and hrp.Parent then
				hrp.CFrame = originalCFrame
			end
			
			isCollectingCrystal = false
		end)
	end)
	table.insert(connections, c)
	return c
end

-- TP to each balloon, fire it, then return.
local function popAllBalloons(btn)
	btn.Text = "Popping..."
	btn.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
	btn.Active = false

	local character = localPlayer.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		btn.Text = "Pop Balloons"
		btn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
		btn.Active = true
		return
	end

	local originalCFrame = hrp.CFrame

	local grandOpening = workspace:FindFirstChild("GrandOpening")
	if grandOpening then
		for i = 1, 8 do
			local balloon = grandOpening:FindFirstChild("Balloon" .. i)
			if balloon then
				local cd = nil
				for _, obj in ipairs(balloon:GetDescendants()) do
					if obj:IsA("ClickDetector") then
						cd = obj
						break
					end
				end

				if cd then
					hrp.CFrame = CFrame.new(cd.Parent.Position)
					task.wait(0.5)
					fireclickdetector(cd)
					task.wait(1)
				end
			end
		end
	end

	hrp.CFrame = originalCFrame

	task.wait(0.5)
	btn.Text = "Pop Balloons"
	btn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
	btn.Active = true
end

